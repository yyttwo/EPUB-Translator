<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">
    <Identity
        Name="EPUBTranslator.Windows.Foundation"
        Publisher="CN=Development"
        Version="0.1.0.0" />
    <mp:PhoneIdentity
        PhoneProductId="be6f273a-e9d8-4f86-865c-c46f13db4e3d"
        PhonePublisherId="00000000-0000-0000-0000-000000000000" />
    <Properties>
        <DisplayName>EPUB翻译</DisplayName>
        <PublisherDisplayName>EPUB翻译</PublisherDisplayName>
        <Logo>Assets\StoreLogo.png</Logo>
    </Properties>
    <Dependencies>
        <TargetDeviceFamily
            Name="Windows.Desktop"
            MinVersion="10.0.19045.0"
            MaxVersionTested="10.0.28000.0" />
    </Dependencies>
    <Resources>
        <Resource Language="zh-CN" />
    </Resources>
    <Applications>
        <Application
            Id="App"
            Executable="EPUBTranslator.App.exe"
            EntryPoint="EPUBTranslator.App.App">
            <uap:VisualElements
                DisplayName="EPUB翻译"
                Description="Windows 原生 EPUB 翻译工具"
                BackgroundColor="transparent"
                Square150x150Logo="Assets\Square150x150Logo.png"
                Square44x44Logo="Assets\Square44x44Logo.png">
                <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
                <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#F8F4EE" />
            </uap:VisualElements>
        </Application>
    </Applications>
    <Capabilities>
        <rescap:Capability Name="runFullTrust" />
    </Capabilities>
</Package>
