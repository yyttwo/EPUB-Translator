<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EPUBTranslator.App.Pages.AboutHelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppPageBrush}">
    <Grid>
        <ScrollViewer>
            <StackPanel
                MaxWidth="960"
                Padding="40,32,40,56"
                HorizontalAlignment="Stretch"
                Spacing="18">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="关于与帮助" />

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="112"
                            Height="112"
                            Source="/Assets/Square150x150Logo.scale-200.png"
                            Stretch="Uniform" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <TextBlock
                                FontFamily="Georgia, Microsoft YaHei UI"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Text="EPUB翻译" />
                            <TextBlock Text="Windows Edition · 0.1.0-dev" />
                            <TextBlock
                                Foreground="{ThemeResource AppMutedTextBrush}"
                                Text="专为电子书设计的 Windows 原生 AI 翻译工具。Stage 1 当前提供文件、凭据与页面基础能力。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="遇到问题？" />
                        <TextBlock
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="反馈由您主动发起。应用不会自动上传日志、API Key、电子书内容或文件路径。"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Left"
                            Click="Feedback_Click"
                            Content="反馈问题…" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            x:Name="StatusInfoBar"
            Margin="24"
            HorizontalAlignment="Stretch"
            IsClosable="True"
            IsOpen="False"
            VerticalAlignment="Bottom" />
    </Grid>
</Page>
