<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EPUBTranslator.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppPageBrush" Color="#FFF8F4EE" />
                    <SolidColorBrush x:Key="AppCardBrush" Color="#EFFFFFFF" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#24748191" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#FFB96F50" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#FF637083" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppPageBrush" Color="#FF24272D" />
                    <SolidColorBrush x:Key="AppCardBrush" Color="#CC30343B" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#357A8494" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#FFD58A68" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#FFB6BEC9" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="24" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Georgia, Microsoft YaHei UI" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
